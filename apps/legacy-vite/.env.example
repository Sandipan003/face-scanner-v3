# MongoDB Connection String
MONGODB_URI=
# NextAuth Secret (Run `openssl rand -base64 32` to generate one)
NEXTAUTH_SECRET=

# JWT Secret (Fallback if NEXTAUTH_SECRET is not used)
JWT_SECRET=

# Presage API Key (Server-side only)
PRESAGE_API_KEY=

# Node Environment
NODE_ENV=development

# Gemini API Key (Keep empty if you want to use the mocked endpoints or put your real key)
GEMINI_API_KEY=